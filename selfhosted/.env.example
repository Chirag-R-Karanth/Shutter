# Copy to .env. Generate both secrets; never commit .env.
DATABASE_URL=mysql+pymysql://shutter_user:CHANGE_ME@127.0.0.1:3306/shutter?charset=utf8mb4
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ARCHIVE_PASSWORD_HASH=REPLACE_WITH_OUTPUT_OF_PWDlib_HASH_COMMAND
DATA_DIR=./data
MAX_UPLOAD_MB=200
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
FFMPEG_PATH=ffmpeg
