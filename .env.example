# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# TMDb (Movies & TV)
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key

# IGDB (Games) — create these at https://dev.twitch.tv/console/apps
# Recommended: provide the client secret so tokens are refreshed automatically.
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret
# Optional fallback: a static app access token (expires after ~60 days).
# IGDB_ACCESS_TOKEN=your_igdb_access_token

# AniList (Anime) & Google Books (Books) do not require API keys for basic public search
